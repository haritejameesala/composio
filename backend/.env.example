# =============================================================================
# Composio Integration — Backend Environment Variables
# Copy this to .env and fill in real values before running.
# NEVER commit .env to version control.
# =============================================================================

# ── Composio ─────────────────────────────────────────────────────────────────
# Your Composio API key — from https://dashboard.composio.dev/settings
# NEVER expose this to the browser/frontend.
COMPOSIO_API_KEY=ck_7gs_Jmvu7jKIAAPXO6Tb

# The default toolkit to provision for new users (must be a NO_AUTH toolkit).
# SERPAPI is a web-search toolkit that requires no user credentials.
# See https://docs.composio.dev/toolkits for other NO_AUTH options.
DEFAULT_TOOLKIT_SLUG=serpapi

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key_32chars

# JWT algorithm (do not change unless you know what you are doing)
ALGORITHM=HS256

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path for local development.
# For production, swap to: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./db/app.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Bootstrap Admin ───────────────────────────────────────────────────────────
# On first startup, an admin account is created with these credentials.
# Change immediately after first run.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
