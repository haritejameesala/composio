# =============================================================================
# Composio Platform — Environment Configuration
# =============================================================================

# ── Backend Configuration (backend/.env) ──────────────────────────────────────

# Required: Composio API Key from https://dashboard.composio.dev/settings
# This is NEVER sent to the browser or frontend.
COMPOSIO_API_KEY=ck_7gs_Jmvu7jKIAAPXO6Tb

# Default NO_AUTH toolkit to provision
DEFAULT_TOOLKIT_SLUG=serpapi

# JWT Auth Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_long_random_secret_key_32chars

# JWT Algorithm and expiry
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./db/app.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap Admin User (Created automatically on first startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# ── Frontend Configuration (frontend/.env) ─────────────────────────────────────
# (Optional when using Vite dev server proxy)
# VITE_API_BASE_URL=http://localhost:8000

